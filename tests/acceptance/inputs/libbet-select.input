gbinput 1
# Libbet control N2 (D-14): libbet-tutorial.input with SELECT tapped where START was tapped.
# Idle past the title (ready near f444; Start taps before f449 are inconsistent).
wait 470f
mark title
wait 30f
tap SELECT 3f
mark play_start
wait 200f
