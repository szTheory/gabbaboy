# Fails when a Phase 12 owner tag ("research:" followed by the number twelve) remains in any
# file named by GBB_FILES. The model-gate table and core must resolve or reassign these rows.
if(NOT DEFINED GBB_FILES OR "${GBB_FILES}" STREQUAL "")
  message(FATAL_ERROR "check_no_phase12_rows.cmake is missing GBB_FILES")
endif()
set(gbb_needle "research:12")
set(gbb_open 0)
foreach(gbb_file IN LISTS GBB_FILES)
  if(NOT EXISTS "${gbb_file}")
    message(FATAL_ERROR "check_no_phase12_rows.cmake: missing file ${gbb_file}")
  endif()
  file(STRINGS "${gbb_file}" gbb_lines)
  foreach(gbb_line IN LISTS gbb_lines)
    string(FIND "${gbb_line}" "${gbb_needle}" gbb_at)
    if(NOT gbb_at EQUAL -1)
      message(SEND_ERROR "phase-12-row-open: ${gbb_file}: ${gbb_line}")
      set(gbb_open 1)
    endif()
  endforeach()
endforeach()
if(gbb_open)
  message(FATAL_ERROR "phase-12-row-open")
endif()
message(STATUS "no-phase12-rows pass")
