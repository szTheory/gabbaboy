function(gbb_validate_age_fixture_protocol manifest_json out_row_indices out_image_indices)
  string(JSON protocol ERROR_VARIABLE protocol_error GET "${manifest_json}" fixture_protocol)
  if(NOT "${protocol_error}" STREQUAL "NOTFOUND" OR
     NOT protocol STREQUAL "gabbaboy-age-fixture-protocol-v1")
    message(FATAL_ERROR "age-fixture-protocol: unsupported or missing fixture_protocol")
  endif()

  string(JSON fixture_count ERROR_VARIABLE count_error LENGTH "${manifest_json}" fixtures)
  if(NOT "${count_error}" STREQUAL "NOTFOUND" OR NOT fixture_count EQUAL 19)
    message(FATAL_ERROR "age-fixture-protocol: expected fixed fixture membership of 19 entries")
  endif()

  set(row_indices)
  set(image_indices)
  math(EXPR fixture_last "${fixture_count} - 1")
  foreach(index RANGE 0 ${fixture_last})
    string(JSON fixture_class ERROR_VARIABLE class_error GET "${manifest_json}" fixtures ${index} fixture_class)
    if(NOT "${class_error}" STREQUAL "NOTFOUND")
      message(FATAL_ERROR "age-fixture-protocol: missing fixture_class at index ${index}")
    endif()

    if(fixture_class STREQUAL "age-row-oracle")
      foreach(field IN ITEMS test_results_address expected_address rows budget_half_dots)
        string(JSON field_type ERROR_VARIABLE field_error TYPE "${manifest_json}" fixtures ${index} ${field})
        if(NOT "${field_error}" STREQUAL "NOTFOUND")
          message(FATAL_ERROR "age-fixture-protocol: row fixture at index ${index} lacks ${field}")
        endif()
        if(field STREQUAL "rows" OR field STREQUAL "budget_half_dots")
          if(NOT field_type STREQUAL "NUMBER")
            message(FATAL_ERROR "age-fixture-protocol: row field ${field} at index ${index} must be numeric")
          endif()
        elseif(NOT field_type STREQUAL "STRING")
          message(FATAL_ERROR "age-fixture-protocol: row field ${field} at index ${index} must be a string")
        endif()
      endforeach()
      list(APPEND row_indices "${index}")
    elseif(fixture_class STREQUAL "age-m3-reference")
      string(JSON qualification_status ERROR_VARIABLE status_error GET "${manifest_json}"
        fixtures ${index} qualification_status)
      if(NOT "${status_error}" STREQUAL "NOTFOUND" OR
         NOT qualification_status STREQUAL "admitted-not-executed")
        message(FATAL_ERROR "age-fixture-protocol: image fixture at index ${index} must remain admitted-not-executed")
      endif()
      foreach(field IN ITEMS test_results_address expected_address rows budget_half_dots)
        string(JSON field_type ERROR_VARIABLE field_error TYPE "${manifest_json}" fixtures ${index} ${field})
        if("${field_error}" STREQUAL "NOTFOUND")
          message(FATAL_ERROR "age-fixture-protocol: image fixture at index ${index} must not define ${field}")
        endif()
      endforeach()
      list(APPEND image_indices "${index}")
    else()
      message(FATAL_ERROR "age-fixture-protocol: unsupported fixture_class ${fixture_class} at index ${index}")
    endif()
  endforeach()

  list(LENGTH row_indices row_count)
  list(LENGTH image_indices image_count)
  if(NOT row_count EQUAL 13 OR NOT image_count EQUAL 6)
    message(FATAL_ERROR "age-fixture-protocol: expected 13 row-oracle and 6 pending image fixtures")
  endif()
  set(${out_row_indices} "${row_indices}" PARENT_SCOPE)
  set(${out_image_indices} "${image_indices}" PARENT_SCOPE)
endfunction()
