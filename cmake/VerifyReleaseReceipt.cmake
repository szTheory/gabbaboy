foreach(required IN ITEMS GBB_RECEIPT GBB_SOURCE_RECEIPT GBB_BUILD_RECEIPT GBB_ASSET GBB_NOTICE_FILE GBB_EXPECTED_VERSION GBB_EXPECTED_TAG GBB_EXPECTED_SOURCE_SHA GBB_EXPECTED_RELEASE_ID)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()

if(NOT EXISTS "${GBB_RECEIPT}" OR NOT EXISTS "${GBB_SOURCE_RECEIPT}" OR NOT EXISTS "${GBB_BUILD_RECEIPT}" OR NOT EXISTS "${GBB_ASSET}")
  message(FATAL_ERROR "Source, build, or downloaded-byte receipt or candidate asset is missing")
endif()
string(LENGTH "${GBB_EXPECTED_SOURCE_SHA}" expected_sha_length)
if(NOT expected_sha_length EQUAL 40 OR NOT GBB_EXPECTED_SOURCE_SHA MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Expected source SHA must be a lowercase full 40-character commit ID")
endif()
if(NOT GBB_EXPECTED_TAG STREQUAL "v${GBB_EXPECTED_VERSION}")
  message(FATAL_ERROR "Expected tag does not match the CMake project version")
endif()

file(READ "${GBB_RECEIPT}" receipt)
file(READ "${GBB_SOURCE_RECEIPT}" source_receipt)
file(READ "${GBB_BUILD_RECEIPT}" build_receipt)
string(JSON schema ERROR_VARIABLE error GET "${receipt}" schema_version)
if(NOT error STREQUAL "NOTFOUND" OR NOT schema EQUAL 1)
  message(FATAL_ERROR "Release receipt schema_version must be 1")
endif()
string(JSON source_schema ERROR_VARIABLE error GET "${source_receipt}" schema_version)
if(NOT error STREQUAL "NOTFOUND" OR NOT source_schema EQUAL 1)
  message(FATAL_ERROR "Source receipt schema_version must be 1")
endif()
string(JSON build_schema ERROR_VARIABLE error GET "${build_receipt}" schema_version)
if(NOT error STREQUAL "NOTFOUND" OR NOT build_schema EQUAL 1)
  message(FATAL_ERROR "Build receipt schema_version must be 1")
endif()
foreach(field IN ITEMS version tag_name source_sha release_id draft source_clean smoke_result notice_file release_notes)
  string(JSON value ERROR_VARIABLE error GET "${receipt}" ${field})
  if(NOT error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Release receipt is missing valid ${field}: ${error}")
  endif()
  set(receipt_${field} "${value}")
endforeach()
if(NOT receipt_version STREQUAL GBB_EXPECTED_VERSION OR NOT receipt_tag_name STREQUAL GBB_EXPECTED_TAG)
  message(FATAL_ERROR "Release receipt version/tag does not match the expected CMake version")
endif()
if(NOT receipt_source_sha STREQUAL GBB_EXPECTED_SOURCE_SHA)
  message(FATAL_ERROR "Release receipt source SHA differs from the trusted tag")
endif()
if(NOT receipt_release_id STREQUAL GBB_EXPECTED_RELEASE_ID)
  message(FATAL_ERROR "Release receipt release ID does not identify the sole existing draft")
endif()
if(NOT receipt_draft)
  message(FATAL_ERROR "Candidate release is published or draft state is missing")
endif()
if(NOT receipt_source_clean)
  message(FATAL_ERROR "Candidate source checkout was not clean")
endif()
foreach(source_field IN ITEMS version tag_name source_sha release_id draft source_clean)
  string(JSON value ERROR_VARIABLE error GET "${source_receipt}" ${source_field})
  if(NOT error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Source receipt is missing valid ${source_field}")
  endif()
  if(NOT "${value}" STREQUAL "${receipt_${source_field}}")
    message(FATAL_ERROR "Source receipt ${source_field} does not match candidate identity")
  endif()
endforeach()
string(JSON source_notes_sha GET "${source_receipt}" release_notes_sha256)
string(JSON source_notice_sha GET "${source_receipt}" notice_sha256)
string(JSON source_notes_text GET "${source_receipt}" release_notes)
string(SHA256 actual_source_notes_sha "${source_notes_text}")
if(NOT actual_source_notes_sha STREQUAL source_notes_sha)
  message(FATAL_ERROR "Source receipt release notes do not match their digest")
endif()
if(NOT receipt_smoke_result STREQUAL "passed")
  message(FATAL_ERROR "Downloaded-byte consumer smoke did not pass")
endif()
if(NOT receipt_notice_file STREQUAL "gabbaboy-notices.txt" OR NOT EXISTS "${GBB_NOTICE_FILE}")
  message(FATAL_ERROR "Release notices are missing or have an unexpected asset name")
endif()
string(JSON notice_sha ERROR_VARIABLE error GET "${receipt}" notice_sha256)
if(NOT error STREQUAL "NOTFOUND" OR NOT notice_sha MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Release notice SHA-256 is missing or malformed")
endif()
string(LENGTH "${notice_sha}" notice_sha_length)
if(NOT notice_sha_length EQUAL 64)
  message(FATAL_ERROR "Release notice SHA-256 must contain 64 characters")
endif()
file(SHA256 "${GBB_NOTICE_FILE}" actual_notice_sha)
if(NOT actual_notice_sha STREQUAL notice_sha)
  message(FATAL_ERROR "Release notice bytes do not match the receipt")
endif()
if(receipt_release_notes STREQUAL "")
  message(FATAL_ERROR "Release notes are missing")
endif()
string(JSON release_notes_sha ERROR_VARIABLE error GET "${receipt}" release_notes_sha256)
if(NOT error STREQUAL "NOTFOUND" OR NOT release_notes_sha MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Release notes SHA-256 is missing or malformed")
endif()
string(LENGTH "${release_notes_sha}" release_notes_sha_length)
if(NOT release_notes_sha_length EQUAL 64)
  message(FATAL_ERROR "Release notes SHA-256 must contain 64 characters")
endif()
string(SHA256 actual_release_notes_sha "${receipt_release_notes}")
if(NOT actual_release_notes_sha STREQUAL release_notes_sha)
  message(FATAL_ERROR "Release notes do not match their recorded digest")
endif()
if(NOT source_notes_sha STREQUAL release_notes_sha OR NOT source_notice_sha STREQUAL notice_sha)
  message(FATAL_ERROR "Source receipt release notes/notices differ from the downloaded-byte receipt")
endif()

foreach(field IN ITEMS compiler cmake runner configuration fixture_manifest_sha256 corpus_manifest_sha256)
  string(JSON value ERROR_VARIABLE error GET "${receipt}" build ${field})
  if(NOT error STREQUAL "NOTFOUND" OR value STREQUAL "")
    message(FATAL_ERROR "Release receipt build.${field} is missing")
  endif()
  set(receipt_build_${field} "${value}")
endforeach()
string(JSON fixture_sha ERROR_VARIABLE error GET "${receipt}" fixtures tracer_manifest_sha256)
if(NOT error STREQUAL "NOTFOUND" OR NOT fixture_sha MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Tracer fixture manifest SHA-256 is malformed")
endif()
string(LENGTH "${fixture_sha}" fixture_sha_length)
if(NOT fixture_sha_length EQUAL 64)
  message(FATAL_ERROR "Tracer fixture manifest SHA-256 must contain 64 characters")
endif()
string(JSON battery_sha ERROR_VARIABLE error GET "${receipt}" fixtures battery_manifest_sha256)
if(NOT error STREQUAL "NOTFOUND" OR NOT battery_sha MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Battery fixture manifest SHA-256 is malformed")
endif()
string(LENGTH "${battery_sha}" battery_sha_length)
if(NOT battery_sha_length EQUAL 64)
  message(FATAL_ERROR "Battery fixture manifest SHA-256 must contain 64 characters")
endif()
string(JSON build_fixture_sha GET "${receipt}" build fixture_manifest_sha256)
string(JSON build_corpus_sha GET "${receipt}" build corpus_manifest_sha256)
if(NOT build_fixture_sha STREQUAL fixture_sha OR NOT build_corpus_sha STREQUAL battery_sha)
  message(FATAL_ERROR "Build receipt fixture/corpus identities disagree with fixture metadata")
endif()
string(JSON asset_count ERROR_VARIABLE error LENGTH "${receipt}" assets)
if(NOT error STREQUAL "NOTFOUND" OR NOT asset_count EQUAL 1)
  message(FATAL_ERROR "Candidate receipt must contain exactly one core archive asset")
endif()
string(JSON asset_name ERROR_VARIABLE error GET "${receipt}" assets 0 name)
if(NOT error STREQUAL "NOTFOUND" OR NOT asset_name STREQUAL "gabbaboy-core-linux-x64.tar.gz")
  message(FATAL_ERROR "Candidate asset name is missing, unexpected, or duplicated")
endif()
string(JSON recorded_sha ERROR_VARIABLE error GET "${receipt}" assets 0 sha256)
if(NOT error STREQUAL "NOTFOUND" OR NOT recorded_sha MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Candidate asset SHA-256 is missing or malformed")
endif()
string(LENGTH "${recorded_sha}" recorded_sha_length)
if(NOT recorded_sha_length EQUAL 64)
  message(FATAL_ERROR "Candidate asset SHA-256 must contain 64 characters")
endif()
file(SHA256 "${GBB_ASSET}" actual_sha)
if(NOT actual_sha STREQUAL recorded_sha)
  message(FATAL_ERROR "Downloaded candidate asset SHA-256 mismatch")
endif()
foreach(field IN ITEMS version tag_name source_sha release_id)
  string(JSON value ERROR_VARIABLE error GET "${build_receipt}" ${field})
  if(NOT error STREQUAL "NOTFOUND" OR NOT "${value}" STREQUAL "${receipt_${field}}")
    message(FATAL_ERROR "Build receipt ${field} does not match candidate identity")
  endif()
endforeach()
string(JSON build_receipt_asset_sha ERROR_VARIABLE error GET "${build_receipt}" asset_sha256)
if(NOT error STREQUAL "NOTFOUND" OR NOT build_receipt_asset_sha STREQUAL recorded_sha)
  message(FATAL_ERROR "Build receipt archive digest differs from downloaded candidate bytes")
endif()
string(JSON build_receipt_asset_name ERROR_VARIABLE error GET "${build_receipt}" asset_name)
if(NOT error STREQUAL "NOTFOUND" OR NOT build_receipt_asset_name STREQUAL "gabbaboy-core-linux-x64.tar.gz")
  message(FATAL_ERROR "Build receipt asset name is unexpected")
endif()
foreach(field IN ITEMS compiler cmake runner configuration fixture_manifest_sha256 corpus_manifest_sha256)
  string(JSON build_receipt_value ERROR_VARIABLE error GET "${build_receipt}" build ${field})
  if(NOT error STREQUAL "NOTFOUND" OR NOT build_receipt_value STREQUAL "${receipt_build_${field}}")
    message(FATAL_ERROR "Build receipt ${field} does not match downloaded-byte receipt")
  endif()
endforeach()
string(JSON build_tracer_sha GET "${build_receipt}" fixtures tracer_manifest_sha256)
string(JSON build_battery_sha GET "${build_receipt}" fixtures battery_manifest_sha256)
if(NOT build_tracer_sha STREQUAL fixture_sha OR NOT build_battery_sha STREQUAL battery_sha)
  message(FATAL_ERROR "Build receipt fixture identities differ from the candidate")
endif()
string(JSON source_receipt_sha ERROR_VARIABLE error GET "${receipt}" source_receipt_sha256)
file(SHA256 "${GBB_SOURCE_RECEIPT}" actual_source_receipt_sha)
if(NOT error STREQUAL "NOTFOUND" OR NOT source_receipt_sha STREQUAL actual_source_receipt_sha)
  message(FATAL_ERROR "Source receipt digest is missing or inconsistent")
endif()
string(JSON build_receipt_sha ERROR_VARIABLE error GET "${receipt}" build_receipt_sha256)
file(SHA256 "${GBB_BUILD_RECEIPT}" actual_build_receipt_sha)
if(NOT error STREQUAL "NOTFOUND" OR NOT build_receipt_sha STREQUAL actual_build_receipt_sha)
  message(FATAL_ERROR "Build receipt digest is missing or inconsistent")
endif()
string(JSON build_source_receipt_sha ERROR_VARIABLE error GET "${build_receipt}" source_receipt_sha256)
if(NOT error STREQUAL "NOTFOUND" OR NOT build_source_receipt_sha STREQUAL actual_source_receipt_sha)
  message(FATAL_ERROR "Build receipt is not bound to the source receipt")
endif()

string(JSON proof_head_sha ERROR_VARIABLE error GET "${receipt}" prior_pr_proof head_sha)
if(NOT error STREQUAL "NOTFOUND" OR NOT proof_head_sha MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Candidate lacks a full exact-head PR proof SHA")
endif()
string(LENGTH "${proof_head_sha}" proof_head_sha_length)
if(NOT proof_head_sha_length EQUAL 40)
  message(FATAL_ERROR "Candidate PR proof SHA must contain 40 characters")
endif()
string(JSON proof_merge_sha ERROR_VARIABLE error GET "${receipt}" prior_pr_proof merge_commit_sha)
if(NOT error STREQUAL "NOTFOUND" OR NOT proof_merge_sha STREQUAL GBB_EXPECTED_SOURCE_SHA)
  message(FATAL_ERROR "Candidate lacks prior exact-head PR proof for the tagged merge commit")
endif()
string(JSON proof_status ERROR_VARIABLE error GET "${receipt}" prior_pr_proof required_checks)
if(NOT error STREQUAL "NOTFOUND" OR NOT proof_status STREQUAL "passed")
  message(FATAL_ERROR "Candidate prior exact-head required checks are absent or non-passing")
endif()
string(JSON source_proof_head GET "${source_receipt}" prior_pr_proof head_sha)
string(JSON source_proof_merge GET "${source_receipt}" prior_pr_proof merge_commit_sha)
string(JSON source_proof_status GET "${source_receipt}" prior_pr_proof required_checks)
string(JSON proof_head GET "${receipt}" prior_pr_proof head_sha)
string(JSON proof_merge GET "${receipt}" prior_pr_proof merge_commit_sha)
if(NOT source_proof_head STREQUAL proof_head OR NOT source_proof_merge STREQUAL proof_merge OR NOT source_proof_status STREQUAL "passed")
  message(FATAL_ERROR "Source and downloaded receipts disagree on exact-head PR proof")
endif()

message(STATUS "Release receipt qualifies ${GBB_EXPECTED_TAG} at ${GBB_EXPECTED_SOURCE_SHA}; downloaded bytes match and smoke passed")
