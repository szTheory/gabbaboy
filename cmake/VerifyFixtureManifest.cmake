# Verify every fixtures[] entry of a manifest: size and SHA-256 of the file
# resolved next to the manifest. Usage: cmake -DMANIFEST=<path> -P <this file>
# An empty or missing fixtures[] array fails so a broken manifest cannot pass
# vacuously.
if(NOT DEFINED MANIFEST OR NOT EXISTS "${MANIFEST}")
  message(FATAL_ERROR "MANIFEST path is required and must exist")
endif()
get_filename_component(manifest_dir "${MANIFEST}" DIRECTORY)
file(READ "${MANIFEST}" manifest_json)
string(JSON count ERROR_VARIABLE json_error LENGTH "${manifest_json}" fixtures)
if(NOT json_error STREQUAL "NOTFOUND" OR count EQUAL 0)
  message(FATAL_ERROR "fixture-manifest-empty: ${MANIFEST}")
endif()
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
  string(JSON name GET "${manifest_json}" fixtures ${i} file)
  string(JSON size GET "${manifest_json}" fixtures ${i} size_bytes)
  string(JSON digest GET "${manifest_json}" fixtures ${i} sha256)
  string(TOLOWER "${digest}" digest)
  set(path "${manifest_dir}/${name}")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "fixture-digest-mismatch: ${name} (missing)")
  endif()
  file(SIZE "${path}" actual_size)
  file(SHA256 "${path}" actual_digest)
  if(NOT actual_size EQUAL size OR NOT actual_digest STREQUAL digest)
    message(FATAL_ERROR "fixture-digest-mismatch: ${name}")
  endif()
  message("fixture-ok ${name} ${actual_digest}")
endforeach()
