# EVID-02 DMG baseline comparator (D-30, D-31, D-34, D-35). Text only, no JSON.
#
# Run through cmake -P from tests/scripts/verify-dmg-baseline.sh (the single entry point).
#
# Inputs (all passed with -D):
#   GBB_MODE         check | print-candidate | junit
#   GBB_SOURCE_DIR   repository root (required)
#   GBB_LEDGER       frozen ledger (default tests/baseline/dmg-cpu-b-v1.txt)
#   GBB_CHANGES      approved-change table (default tests/baseline/CHANGES.md)
#   GBB_RUNNER       gabbaboy-runner executable (live observation)
#   GBB_MEASURE      measure_core executable (live observation)
#   GBB_OBSERVED     optional key<TAB>value file that replaces live collection (self-tests)
#   GBB_JUNIT        JUnit report to check (junit mode)
#   GBB_INVENTORY    core | player (junit mode)
#
# A ledger is key<TAB>value lines in LC_ALL=C byte order. The six header keys name the freeze; every
# other line is the frozen body whose SHA-256 is frozen_body_sha256. This script never writes the
# ledger: print-candidate goes to standard output only, so a baseline can change only through a
# reviewed edit of the ledger plus a recorded CHANGES row.
cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED GBB_MODE)
  set(GBB_MODE check)
endif()
if(NOT DEFINED GBB_SOURCE_DIR OR NOT IS_DIRECTORY "${GBB_SOURCE_DIR}")
  message(FATAL_ERROR "GBB_SOURCE_DIR must name the repository root")
endif()
if(NOT DEFINED GBB_LEDGER OR "${GBB_LEDGER}" STREQUAL "")
  set(GBB_LEDGER "${GBB_SOURCE_DIR}/tests/baseline/dmg-cpu-b-v1.txt")
endif()
if(NOT DEFINED GBB_CHANGES OR "${GBB_CHANGES}" STREQUAL "")
  set(GBB_CHANGES "${GBB_SOURCE_DIR}/tests/baseline/CHANGES.md")
endif()

string(ASCII 9 GBB_TAB)
set(GBB_HEADER_KEYS schema model frozen_revision frozen_date frozen_body_sha256 coverage)

# Prints one line to standard output (message() would go to standard error).
function(gbb_say text)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${text}")
endfunction()

function(gbb_fail text)
  string(REPLACE ";" " " text "${text}")
  gbb_say("baseline status=fail ${text}")
  message(FATAL_ERROR "baseline status=fail ${text}")
endfunction()

# Parses key<TAB>value lines from the variable named by `text_var` into
#   ${prefix}_KEYS   keys in file order        ${prefix}_LINES  raw lines in file order
#   ${prefix}V_<key> the value of each key     ${prefix}_ERR    failure tokens found
# `empty_token` is the failure token for a blank text.
macro(gbb_parse_text text_var prefix empty_token)
  set(${prefix}_LINES "")
  set(${prefix}_KEYS "")
  set(${prefix}_ERR "")
  set(_gbb_c "${${text_var}}")
  string(REPLACE "\r" "" _gbb_c "${_gbb_c}")
  string(STRIP "${_gbb_c}" _gbb_stripped)
  if("${_gbb_stripped}" STREQUAL "")
    list(APPEND ${prefix}_ERR ${empty_token})
  else()
    # A semicolon would split a CMake list element; no valid ledger value contains one.
    string(FIND "${_gbb_c}" ";" _gbb_semi)
    if(NOT _gbb_semi EQUAL -1)
      list(APPEND ${prefix}_ERR malformed-line)
      string(REPLACE ";" "_" _gbb_c "${_gbb_c}")
    endif()
    string(REGEX REPLACE "\n$" "" _gbb_c "${_gbb_c}")
    string(REPLACE "\n" ";" _gbb_lines "${_gbb_c}")
    foreach(_gbb_l IN LISTS _gbb_lines)
      if(_gbb_l MATCHES "^([A-Za-z0-9_.-]+)${GBB_TAB}([^${GBB_TAB}]+)$")
        set(_gbb_k "${CMAKE_MATCH_1}")
        if(DEFINED ${prefix}V_${_gbb_k})
          list(APPEND ${prefix}_ERR duplicate-key)
        endif()
        set(${prefix}V_${_gbb_k} "${CMAKE_MATCH_2}")
        list(APPEND ${prefix}_KEYS "${_gbb_k}")
        list(APPEND ${prefix}_LINES "${_gbb_l}")
      else()
        list(APPEND ${prefix}_ERR malformed-line)
      endif()
    endforeach()
  endif()
  list(REMOVE_DUPLICATES ${prefix}_ERR)
endmacro()

macro(gbb_parse_file file prefix empty_token)
  set(_gbb_file_text "")
  if(EXISTS "${file}")
    file(READ "${file}" _gbb_file_text)
  endif()
  gbb_parse_text(_gbb_file_text ${prefix} ${empty_token})
endmacro()

# Classifies a key: header | provenance | advisory | inventory | mooneye | acceptance | bench | unknown
function(gbb_section key out)
  if(key IN_LIST GBB_HEADER_KEYS)
    set(${out} header PARENT_SCOPE)
  elseif(key STREQUAL "inventory.sha256")
    set(${out} provenance PARENT_SCOPE)
  elseif(key MATCHES "^inventory\\.(core|player)\\.")
    set(${out} inventory PARENT_SCOPE)
  elseif(key MATCHES "^mooneye\\.")
    set(${out} mooneye PARENT_SCOPE)
  elseif(key MATCHES "^acceptance\\.")
    set(${out} acceptance PARENT_SCOPE)
  elseif(key MATCHES "^bench\\.advisory\\.")
    set(${out} advisory PARENT_SCOPE)
  elseif(key MATCHES "^bench\\.")
    set(${out} bench PARENT_SCOPE)
  else()
    set(${out} unknown PARENT_SCOPE)
  endif()
endfunction()

# Joins the given key list (sorted here) into "key<TAB>value" lines joined by LF, no trailing LF,
# reading values from variables named ${prefix}V_<key> (the naming gbb_parse_text uses).
function(gbb_body_text prefix out)
  set(sorted_keys ${ARGN})
  list(SORT sorted_keys)
  set(body "")
  set(first TRUE)
  foreach(key IN LISTS sorted_keys)
    if(first)
      set(body "${key}${GBB_TAB}${${prefix}V_${key}}")
      set(first FALSE)
    else()
      string(APPEND body "\n${key}${GBB_TAB}${${prefix}V_${key}}")
    endif()
  endforeach()
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

# Validates the ledger's structure and header. Returns failure tokens in L_ERR (caller scope).
macro(gbb_validate_ledger)
  gbb_parse_file("${GBB_LEDGER}" L empty-ledger)
  if(NOT "empty-ledger" IN_LIST L_ERR)
    set(_gbb_sorted ${L_LINES})
    list(SORT _gbb_sorted)
    if(NOT "${_gbb_sorted}" STREQUAL "${L_LINES}")
      list(APPEND L_ERR unsorted-ledger)
    endif()
    set(_gbb_header_bad FALSE)
    foreach(_gbb_k IN LISTS L_KEYS)
      gbb_section("${_gbb_k}" _gbb_sec)
      if(_gbb_sec STREQUAL "unknown")
        list(APPEND L_ERR malformed-line)
      endif()
    endforeach()
    foreach(_gbb_h IN LISTS GBB_HEADER_KEYS)
      if(NOT DEFINED LV_${_gbb_h})
        set(_gbb_header_bad TRUE)
      endif()
    endforeach()
    if(NOT _gbb_header_bad)
      # CMake regular expressions have no {n} quantifier, so lengths are checked separately.
      string(LENGTH "${LV_frozen_revision}" _gbb_rev_len)
      string(LENGTH "${LV_frozen_body_sha256}" _gbb_sha_len)
      if(NOT LV_schema MATCHES "^[a-z0-9][a-z0-9-]*$"
          OR NOT LV_model MATCHES "^[a-z0-9][a-z0-9-]*$"
          OR NOT LV_frozen_revision MATCHES "^[0-9a-f]+$" OR NOT _gbb_rev_len EQUAL 40
          OR NOT LV_frozen_date MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]"
          OR NOT LV_frozen_body_sha256 MATCHES "^[0-9a-f]+$" OR NOT _gbb_sha_len EQUAL 64)
        set(_gbb_header_bad TRUE)
      endif()
    endif()
    if(_gbb_header_bad)
      list(APPEND L_ERR header-invalid)
    endif()
    list(REMOVE_DUPLICATES L_ERR)
  endif()
endmacro()

# Approved-change protocol (D-34). CHANGES.md rows
#   | key | old | new | reason | evidence class and citation | approver |
# are reverse-applied, newest (last) first, to the ledger body; the result must hash to
# frozen_body_sha256, otherwise the ledger changed without a recorded, approved reason.
# "<absent>" as old or new records a key that was added or removed. Sets `findings` (tokens) and
# `row_count` in the caller.
function(gbb_check_changes findings row_count)
  set(found "")
  set(rows "")
  if(NOT EXISTS "${GBB_CHANGES}")
    set(${findings} "changes-inconsistent:file-missing" PARENT_SCOPE)
    set(${row_count} 0 PARENT_SCOPE)
    return()
  endif()
  file(READ "${GBB_CHANGES}" text)
  string(REPLACE "\r" "" text "${text}")
  string(REPLACE ";" "<semi>" text "${text}")
  string(REPLACE "\n" ";" lines "${text}")
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "^[ ]*[|](.*)[|][ ]*$")
      continue()
    endif()
    string(REPLACE "|" ";" cells "${CMAKE_MATCH_1}")
    set(clean "")
    foreach(cell IN LISTS cells)
      string(STRIP "${cell}" cell)
      string(REGEX REPLACE "^`(.*)`$" "\\1" cell "${cell}")
      list(APPEND clean "${cell}")
    endforeach()
    list(GET clean 0 first_cell)
    if(first_cell STREQUAL "key" OR first_cell MATCHES "^[-: ]+$")
      continue()
    endif()
    list(LENGTH clean n)
    if(NOT n EQUAL 6)
      list(APPEND found "changes-inconsistent:malformed-row")
      continue()
    endif()
    string(JOIN "${GBB_TAB}" row ${clean})
    list(APPEND rows "${row}")
  endforeach()

  # Working copy of the ledger body, reversed one row at a time.
  set(work_keys "")
  foreach(key IN LISTS L_KEYS)
    if(NOT key IN_LIST GBB_HEADER_KEYS)
      list(APPEND work_keys "${key}")
      set(WV_${key} "${LV_${key}}")
    endif()
  endforeach()
  list(LENGTH rows count)
  set(row_errors FALSE)
  set(index ${count})
  while(index GREATER 0)
    math(EXPR index "${index} - 1")
    list(GET rows ${index} row)
    string(REPLACE "${GBB_TAB}" ";" fields "${row}")
    list(GET fields 0 key)
    list(GET fields 1 old)
    list(GET fields 2 new)
    list(GET fields 3 reason)
    list(GET fields 4 evidence)
    list(GET fields 5 approver)
    if("${reason}" STREQUAL "" OR "${evidence}" STREQUAL "" OR "${approver}" STREQUAL "")
      list(APPEND found "changes-inconsistent:incomplete-row:${key}")
      set(row_errors TRUE)
    elseif(old STREQUAL new)
      list(APPEND found "changes-noop:${key}")
      set(row_errors TRUE)
    elseif(key IN_LIST GBB_HEADER_KEYS)
      list(APPEND found "changes-inconsistent:header-key:${key}")
      set(row_errors TRUE)
    else()
      if(DEFINED WV_${key})
        set(current "${WV_${key}}")
      else()
        set(current "<absent>")
      endif()
      if(NOT current STREQUAL new)
        list(APPEND found "changes-inconsistent:${key}")
        set(row_errors TRUE)
      elseif(old STREQUAL "<absent>")
        unset(WV_${key})
        list(REMOVE_ITEM work_keys "${key}")
      else()
        if(NOT DEFINED WV_${key})
          list(APPEND work_keys "${key}")
        endif()
        set(WV_${key} "${old}")
      endif()
    endif()
  endwhile()

  if(NOT row_errors)
    gbb_body_text(W body ${work_keys})
    string(SHA256 digest "${body}")
    if(NOT digest STREQUAL LV_frozen_body_sha256)
      list(APPEND found "unrecorded-change")
    endif()
  endif()
  set(${findings} "${found}" PARENT_SCOPE)
  set(${row_count} ${count} PARENT_SCOPE)
endfunction()

# Runs a command in GBB_SOURCE_DIR and stores its standard output in `out`.
function(gbb_capture out what)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${GBB_SOURCE_DIR}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT rc STREQUAL "0")
    gbb_fail("observation-failed ${what} exit=${rc} ${err}")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Appends "inventory.<kind>.<name><TAB>frozen" for each name of an inventory file and records the key.
function(gbb_inventory_lines kind file out_lines out_keys)
  file(READ "${file}" text)
  string(REPLACE "\r" "" text "${text}")
  string(REPLACE ";" "_" text "${text}")
  string(REPLACE "\n" ";" names "${text}")
  set(lines "")
  set(keys "")
  foreach(name IN LISTS names)
    if(NOT "${name}" STREQUAL "")
      string(APPEND lines "inventory.${kind}.${name}${GBB_TAB}frozen\n")
      list(APPEND keys "inventory.${kind}.${name}")
    endif()
  endforeach()
  set(${out_lines} "${lines}" PARENT_SCOPE)
  set(${out_keys} "${keys}" PARENT_SCOPE)
endfunction()

# Recomputes every observation from the live build and the repository; result is key<TAB>value text.
function(gbb_collect_live out)
  if(NOT DEFINED GBB_RUNNER OR NOT EXISTS "${GBB_RUNNER}" OR NOT DEFINED GBB_MEASURE OR NOT EXISTS "${GBB_MEASURE}")
    gbb_fail("observation-failed GBB_RUNNER and GBB_MEASURE must name built executables")
  endif()
  gbb_capture(acceptance_text acceptance "${GBB_RUNNER}"
    --acceptance tests/acceptance/cases.txt --case libbet --observe)
  gbb_capture(mooneye_text mooneye "${GBB_RUNNER}"
    --manifest fixtures/mooneye/manifest.json --suite --observe)
  gbb_capture(measure_text measure "${GBB_MEASURE}" --no-trace fixtures/tracer/tracer.gb)
  if(NOT measure_text MATCHES "correctness_digest_fnv1a64=([0-9a-f]+)")
    gbb_fail("observation-failed measure_core printed no correctness_digest_fnv1a64")
  endif()
  set(digest "${CMAKE_MATCH_1}")
  if(NOT measure_text MATCHES "workload=([^ \n\r]+)")
    gbb_fail("observation-failed measure_core printed no workload")
  endif()
  set(workload "${CMAKE_MATCH_1}")

  gbb_inventory_lines(core "${GBB_SOURCE_DIR}/tests/expected-tests.txt" core_lines core_keys)
  gbb_inventory_lines(player "${GBB_SOURCE_DIR}/tests/player/expected-tests.txt" player_lines player_keys)
  # Provenance only (see the ledger rules): a digest of the sorted inventory key lists.
  set(all_keys ${core_keys} ${player_keys})
  list(SORT all_keys)
  string(REPLACE ";" "\n" inventory_text "${all_keys}")
  string(SHA256 inventory_digest "${inventory_text}")

  set(text "${acceptance_text}${mooneye_text}${core_lines}${player_lines}")
  string(APPEND text "inventory.sha256${GBB_TAB}${inventory_digest}\n")
  string(APPEND text "bench.tracer.correctness_digest_fnv1a64${GBB_TAB}${digest}\n")
  string(APPEND text "bench.tracer.workload${GBB_TAB}${workload}\n")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Gathers observations into O_* (from GBB_OBSERVED when given, else live).
macro(gbb_observe)
  if(DEFINED GBB_OBSERVED AND NOT "${GBB_OBSERVED}" STREQUAL "")
    gbb_parse_file("${GBB_OBSERVED}" O empty-observations)
  else()
    gbb_collect_live(_gbb_live_text)
    gbb_parse_text(_gbb_live_text O empty-observations)
  endif()
endmacro()

# ---------------------------------------------------------------------------------------------
if(GBB_MODE STREQUAL "print-candidate")
  gbb_observe()
  if(O_ERR)
    gbb_fail("${O_ERR} (observations)")
  endif()
  execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${GBB_SOURCE_DIR}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE)
  string(LENGTH "${revision}" revision_length)
  if(NOT rc STREQUAL "0" OR NOT revision MATCHES "^[0-9a-f]+$" OR NOT revision_length EQUAL 40)
    gbb_fail("observation-failed git rev-parse HEAD")
  endif()
  string(TIMESTAMP frozen_date "%Y-%m-%dT%H:%M:%SZ" UTC)

  gbb_body_text(O body_text ${O_KEYS})
  string(SHA256 body_digest "${body_text}")
  set(candidate_lines ${O_LINES})
  list(APPEND candidate_lines
    "schema${GBB_TAB}gabbaboy-dmg-baseline-v1"
    "model${GBB_TAB}dmg-cpu-b"
    "frozen_revision${GBB_TAB}${revision}"
    "frozen_date${GBB_TAB}${frozen_date}"
    "frozen_body_sha256${GBB_TAB}${body_digest}"
    "coverage${GBB_TAB}PLACEHOLDER-replaced-at-freeze")
  list(SORT candidate_lines)
  string(REPLACE ";" "\n" candidate_text "${candidate_lines}")

  # Standard output only; the temporary file exists just to hand the text to `cmake -E cat`.
  if(DEFINED ENV{TMPDIR})
    set(tmp_root "$ENV{TMPDIR}")
  elseif(DEFINED ENV{TEMP})
    set(tmp_root "$ENV{TEMP}")
  else()
    set(tmp_root "/tmp")
  endif()
  string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" tmp_name)
  set(tmp_dir "${tmp_root}/gbb-candidate-${tmp_name}")
  file(MAKE_DIRECTORY "${tmp_dir}")
  file(WRITE "${tmp_dir}/candidate.txt" "${candidate_text}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E cat "${tmp_dir}/candidate.txt" RESULT_VARIABLE rc)
  file(REMOVE_RECURSE "${tmp_dir}")
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "could not print the candidate ledger")
  endif()

elseif(GBB_MODE STREQUAL "check")
  gbb_validate_ledger()
  gbb_observe()
  set(structural ${L_ERR} ${O_ERR})
  foreach(frozen_section inventory mooneye acceptance bench)
    set(count_${frozen_section} 0)
  endforeach()
  foreach(key IN LISTS L_KEYS)
    gbb_section("${key}" sec)
    if(DEFINED count_${sec})
      math(EXPR count_${sec} "${count_${sec}} + 1")
    endif()
  endforeach()
  if(NOT "empty-ledger" IN_LIST L_ERR)
    foreach(frozen_section inventory mooneye acceptance bench)
      if(count_${frozen_section} EQUAL 0)
        list(APPEND structural empty-section)
        set(empty_section_name "${frozen_section}")
      endif()
    endforeach()
  endif()
  list(REMOVE_DUPLICATES structural)
  if(structural)
    gbb_fail("${structural} ${empty_section_name}")
  endif()

  foreach(cat inventory mooneye acceptance bench)
    set(findings_${cat} "")
  endforeach()
  foreach(key IN LISTS L_KEYS)
    gbb_section("${key}" sec)
    if(sec STREQUAL "inventory")
      if(NOT DEFINED OV_${key})
        list(APPEND findings_inventory "removed:${key}")
      endif()
    elseif(sec STREQUAL "mooneye" OR sec STREQUAL "acceptance" OR sec STREQUAL "bench")
      if(NOT DEFINED OV_${key})
        list(APPEND findings_${sec} "missing:${key}")
      elseif(NOT "${OV_${key}}" STREQUAL "${LV_${key}}")
        list(APPEND findings_${sec} "modified:${key}")
      endif()
    endif()
  endforeach()
  foreach(key IN LISTS O_KEYS)
    gbb_section("${key}" sec)
    if((sec STREQUAL "mooneye" OR sec STREQUAL "acceptance" OR sec STREQUAL "bench") AND NOT DEFINED LV_${key})
      list(APPEND findings_${sec} "extra:${key}")
    endif()
  endforeach()

  set(failed FALSE)
  foreach(cat inventory mooneye acceptance bench)
    if(findings_${cat})
      set(failed TRUE)
      list(LENGTH findings_${cat} n)
      list(SUBLIST findings_${cat} 0 5 shown)
      string(REPLACE ";" " " shown "${shown}")
      gbb_say("baseline ${cat}=fail ${shown} (${n} total)")
    else()
      gbb_say("baseline ${cat}=ok keys=${count_${cat}}")
    endif()
  endforeach()
  gbb_check_changes(changes_findings changes_rows)
  if(changes_findings)
    set(failed TRUE)
    list(REMOVE_DUPLICATES changes_findings)
    string(REPLACE ";" " " shown "${changes_findings}")
    gbb_say("baseline changes=fail ${shown}")
  else()
    gbb_say("baseline changes=ok rows=${changes_rows}")
  endif()
  if(failed)
    message(FATAL_ERROR "baseline status=fail")
  endif()
  gbb_say("baseline status=pass")

elseif(GBB_MODE STREQUAL "junit")
  # Every frozen test name of the chosen inventory must have a testcase with no skipped, failure or
  # error child. The ledger's structure is validated first so a damaged ledger cannot shrink the list.
  gbb_validate_ledger()
  if(L_ERR)
    gbb_fail("${L_ERR} (ledger)")
  endif()
  if(NOT DEFINED GBB_INVENTORY OR NOT GBB_INVENTORY MATCHES "^(core|player)$")
    gbb_fail("junit-invalid GBB_INVENTORY must be core or player")
  endif()
  set(names "")
  foreach(key IN LISTS L_KEYS)
    if(key MATCHES "^inventory\\.${GBB_INVENTORY}\\.(.+)$")
      list(APPEND names "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(NOT names)
    gbb_fail("empty-section inventory.${GBB_INVENTORY}")
  endif()
  if(NOT DEFINED GBB_JUNIT OR NOT EXISTS "${GBB_JUNIT}")
    gbb_fail("junit-missing report ${GBB_JUNIT} does not exist")
  endif()
  file(READ "${GBB_JUNIT}" junit_text)
  string(REPLACE "\r" "" junit_text "${junit_text}")
  string(REPLACE ";" "<semi>" junit_text "${junit_text}")
  # Each chunk starts at a <testcase tag and runs to the next one, so child elements stay with it.
  string(REPLACE "<testcase" ";<testcase" junit_text "${junit_text}")
  set(seen "")
  set(skipped "")
  set(failed "")
  foreach(chunk IN LISTS junit_text)
    if(NOT chunk MATCHES "^<testcase[ \t\n]")
      continue()
    endif()
    if(NOT chunk MATCHES "^<testcase[^>]*[ \t\n]name=\"([^\"]*)\"")
      continue()
    endif()
    set(case_name "${CMAKE_MATCH_1}")
    list(APPEND seen "${case_name}")
    if(chunk MATCHES "<skipped([ \t\n>/]|$)")
      list(APPEND skipped "${case_name}")
    endif()
    if(chunk MATCHES "<(failure|error)([ \t\n>/]|$)")
      list(APPEND failed "${case_name}")
    endif()
  endforeach()
  set(findings "")
  foreach(name IN LISTS names)
    if(NOT name IN_LIST seen)
      list(APPEND findings "junit-missing:${name}")
    elseif(name IN_LIST skipped)
      list(APPEND findings "junit-skipped:${name}")
    elseif(name IN_LIST failed)
      list(APPEND findings "junit-failed:${name}")
    endif()
  endforeach()
  if(findings)
    gbb_fail("${findings}")
  endif()
  list(LENGTH names name_count)
  gbb_say("baseline junit=ok inventory=${GBB_INVENTORY} names=${name_count}")

else()
  message(FATAL_ERROR "baseline status=fail unknown-mode GBB_MODE=${GBB_MODE}")
endif()
