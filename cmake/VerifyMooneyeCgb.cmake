cmake_minimum_required(VERSION 3.25)

# Fail-closed verification of the Phase 10 Mooneye CGB derivative set (D-26; adapted from
# VerifyMooneyeMbc.cmake). The pc-table mode is added by Plan 10-16 once the runner table exists;
# the gbb:cgb-rows-begin / gbb:cgb-rows-end marker names are reserved for it.
#
#   GBB_MOONEYE_DIR      fixtures/mooneye-cgb (required)
#   GBB_MANIFEST         optional manifest path; defaults to <dir>/manifest.json (tamper controls point elsewhere)
#   GBB_MODE             digest | inventory
#
# Failure tokens: Duplicate fixture id, Duplicate ROM path, Fixture ... mismatch (digest), inventory: ...
# Only portable CMake commands are used (file(SIZE), file(SHA256), string(JSON), cmake_path).

if(NOT DEFINED GBB_MOONEYE_DIR)
  message(FATAL_ERROR "GBB_MOONEYE_DIR is required")
endif()
if(NOT DEFINED GBB_MODE)
  message(FATAL_ERROR "GBB_MODE is required (digest | inventory)")
endif()
if(NOT GBB_MODE STREQUAL "digest" AND NOT GBB_MODE STREQUAL "inventory")
  message(FATAL_ERROR "Unknown GBB_MODE: ${GBB_MODE}")
endif()

cmake_path(ABSOLUTE_PATH GBB_MOONEYE_DIR
  BASE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/.." NORMALIZE OUTPUT_VARIABLE fixture_dir)
if(DEFINED GBB_MANIFEST AND NOT "${GBB_MANIFEST}" STREQUAL "")
  set(manifest_path "${GBB_MANIFEST}")
else()
  set(manifest_path "${fixture_dir}/manifest.json")
endif()
if(NOT EXISTS "${manifest_path}")
  message(FATAL_ERROR "Missing manifest: ${manifest_path}")
endif()

file(READ "${manifest_path}" manifest_json)
string(JSON fixture_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" fixtures)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT fixture_count EQUAL 4)
  message(FATAL_ERROR "Manifest fixtures must be a JSON array of exactly 4 entries: ${json_error} (${fixture_count})")
endif()

# Read one fixture field, failing with the field name when it is missing or empty.
function(gbb_fixture_field out index field)
  string(JSON value ERROR_VARIABLE json_error GET "${manifest_json}" fixtures ${index} ${field})
  if(NOT json_error STREQUAL "NOTFOUND" OR "${value}" STREQUAL "")
    message(FATAL_ERROR "Fixture ${index} is missing '${field}': ${json_error}")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Per-entry invariants shared by every mode.
set(seen_ids "")
set(seen_roms "")
foreach(index RANGE 0 3)
  gbb_fixture_field(id ${index} id)
  gbb_fixture_field(rom ${index} rom)
  gbb_fixture_field(eligible ${index} eligible)
  if(id IN_LIST seen_ids)
    message(FATAL_ERROR "Duplicate fixture id: ${id}")
  endif()
  if(rom IN_LIST seen_roms)
    message(FATAL_ERROR "Duplicate ROM path in eligible inventory: ${rom}")
  endif()
  if(rom MATCHES "[/\\\\]|\\.\\.")
    message(FATAL_ERROR "Fixture ROM must be a local filename: ${rom}")
  endif()
  if(NOT eligible)
    message(FATAL_ERROR "Every entry in fixtures must be eligible: ${id}")
  endif()
  list(APPEND seen_ids "${id}")
  list(APPEND seen_roms "${rom}")
endforeach()

if(GBB_MODE STREQUAL "inventory")
  # The exact four-ROM set, in manifest order, with the expectation each one is pinned to (D-26).
  set(want_ids boot_regs-cgb boot_div-cgbABCDE boot_hwio-C unused_hwio-C)
  set(want_categories post-boot-registers post-boot-div post-boot-hwio unused-hwio)
  set(want_expects pass pass expected-unsupported expected-unsupported)
  string(JSON required_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" required_roms)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT required_count EQUAL 4)
    message(FATAL_ERROR "inventory: required_roms must list exactly 4 ROMs (${required_count})")
  endif()
  foreach(index RANGE 0 3)
    list(GET want_ids ${index} want_id)
    gbb_fixture_field(alias ${index} alias)
    gbb_fixture_field(category ${index} category)
    gbb_fixture_field(expect ${index} expect)
    gbb_fixture_field(rom ${index} rom)
    list(GET want_categories ${index} want_category)
    list(GET want_expects ${index} want_expect)
    if(NOT alias STREQUAL want_id)
      message(FATAL_ERROR "inventory: fixture ${index} alias '${alias}' must be '${want_id}'")
    endif()
    if(NOT category STREQUAL want_category)
      message(FATAL_ERROR "inventory: ${alias} category '${category}' must be '${want_category}'")
    endif()
    if(NOT expect STREQUAL want_expect)
      message(FATAL_ERROR "inventory: ${alias} expect '${expect}' must be '${want_expect}'")
    endif()
    string(JSON required_rom ERROR_VARIABLE json_error GET "${manifest_json}" required_roms ${index})
    if(NOT json_error STREQUAL "NOTFOUND" OR NOT required_rom STREQUAL rom)
      message(FATAL_ERROR "inventory: required_roms[${index}] '${required_rom}' must equal fixture ROM '${rom}'")
    endif()
    if(expect STREQUAL "expected-unsupported")
      gbb_fixture_field(stop_address ${index} expect_stop_address)
      if(NOT stop_address STREQUAL "0xFF76")
        message(FATAL_ERROR "inventory: ${alias} expect_stop_address '${stop_address}' must be '0xFF76'")
      endif()
    endif()
  endforeach()
  message(STATUS "Verified Mooneye-cgb inventory: 4 fixtures (2 pass, 2 expected-unsupported at 0xFF76), 4 required ROM(s)")
  return()
endif()

# ---- digest mode ----
foreach(required_file IN ITEMS manifest.json LICENSE.txt FONT-LICENSE.txt SOURCES.md ELIGIBILITY.md)
  if(NOT EXISTS "${fixture_dir}/${required_file}")
    message(FATAL_ERROR "Missing required Mooneye-cgb corpus file: ${required_file}")
  endif()
endforeach()

foreach(index RANGE 0 3)
  gbb_fixture_field(id ${index} id)
  gbb_fixture_field(rom ${index} rom)
  gbb_fixture_field(digest ${index} sha256)
  gbb_fixture_field(expected_size ${index} size_bytes)
  string(LENGTH "${digest}" digest_length)
  if(NOT digest MATCHES "^[0-9a-fA-F]+$" OR NOT digest_length EQUAL 64 OR
     NOT expected_size MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Fixture ${id} has malformed size or SHA-256 metadata")
  endif()
  set(rom_path "${fixture_dir}/${rom}")
  if(NOT EXISTS "${rom_path}")
    message(FATAL_ERROR "Missing required selected ROM: ${rom_path}")
  endif()
  file(SIZE "${rom_path}" actual_size)
  file(SHA256 "${rom_path}" actual_digest)
  if(NOT actual_size EQUAL expected_size OR NOT actual_digest STREQUAL digest)
    message(FATAL_ERROR "Fixture ${id} mismatch: size ${actual_size}/${expected_size}, SHA-256 ${actual_digest}/${digest}")
  endif()
endforeach()

# Parent references (D-24): three real repository files, each with its own matching SHA-256.
cmake_path(ABSOLUTE_PATH fixture_dir BASE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/.." NORMALIZE OUTPUT_VARIABLE fixture_dir_norm)
cmake_path(GET fixture_dir_norm PARENT_PATH fixtures_root)
cmake_path(GET fixtures_root PARENT_PATH repo_root)
string(JSON ref_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" parent_references)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT ref_count EQUAL 3)
  message(FATAL_ERROR "parent_references must list exactly three entries (${ref_count})")
endif()
set(expected_refs ../mooneye/headless-report.patch ../mooneye/font-source.c ../mooneye/manifest.json)
set(ref_paths "")
foreach(index RANGE 0 2)
  string(JSON ref_path ERROR_VARIABLE json_error GET "${manifest_json}" parent_references ${index} path)
  string(JSON ref_sha ERROR_VARIABLE json_error2 GET "${manifest_json}" parent_references ${index} sha256)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT json_error2 STREQUAL "NOTFOUND" OR ref_path STREQUAL "")
    message(FATAL_ERROR "parent-reference-invalid: entry ${index} lacks path or sha256")
  endif()
  if(ref_path MATCHES "#" OR ref_path MATCHES "\\\\" OR IS_ABSOLUTE "${ref_path}")
    message(FATAL_ERROR "parent-reference-invalid: ${ref_path}")
  endif()
  cmake_path(APPEND fixture_dir_norm "${ref_path}" OUTPUT_VARIABLE ref_abs)
  cmake_path(NORMAL_PATH ref_abs)
  string(FIND "${ref_abs}" "${repo_root}/" inside_repo)
  if(NOT inside_repo EQUAL 0)
    message(FATAL_ERROR "parent-reference-invalid: ${ref_path}")
  endif()
  if(NOT EXISTS "${ref_abs}" OR IS_DIRECTORY "${ref_abs}")
    message(FATAL_ERROR "parent-reference-invalid: ${ref_path}")
  endif()
  file(SHA256 "${ref_abs}" ref_actual)
  if(NOT ref_actual STREQUAL ref_sha)
    message(FATAL_ERROR "parent-reference-digest: ${ref_path}")
  endif()
  list(APPEND ref_paths "${ref_path}")
  if(ref_path STREQUAL "../mooneye/manifest.json")
    set(parent_manifest_path "${ref_abs}")
  endif()
endforeach()
if(NOT ref_paths STREQUAL expected_refs)
  message(FATAL_ERROR "parent-reference-invalid: expected exactly ${expected_refs}, got ${ref_paths}")
endif()

# The builder pin lives in the digest-checked parent manifest and is referenced, not copied (D-24).
string(JSON own_builder_type ERROR_VARIABLE json_error TYPE "${manifest_json}" builder)
if(json_error STREQUAL "NOTFOUND")
  message(FATAL_ERROR "builder-pin-mismatch: the sibling manifest must not carry its own builder object")
endif()
file(READ "${parent_manifest_path}" parent_json)
string(JSON builder_revision ERROR_VARIABLE json_error GET "${parent_json}" builder source_revision)
string(JSON builder_archive ERROR_VARIABLE json_error2 GET "${parent_json}" builder git_archive_sha256)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT json_error2 STREQUAL "NOTFOUND" OR
   NOT builder_revision STREQUAL "91c52b1f4ef3cc8ba3c0638f7536539579af6a9f" OR builder_archive STREQUAL "")
  message(FATAL_ERROR "builder-pin-mismatch: parent manifest must pin WLA-DX 91c52b1f4ef3cc8ba3c0638f7536539579af6a9f")
endif()

string(JSON suite_revision GET "${manifest_json}" suite revision)
string(JSON suite_tree GET "${manifest_json}" suite tree_sha1)
if(NOT suite_revision STREQUAL "31510e12eea6286d36eea060a6adde755e1067aa" OR
   NOT suite_tree STREQUAL "2b8c52424a49a2a7466cf631fd8992c53d0de2fa")
  message(FATAL_ERROR "Mooneye source revision or tree does not match the reviewed immutable pin")
endif()

message(STATUS "Verified 4 eligible Mooneye-cgb ROM(s) against ${manifest_path}")
