cmake_minimum_required(VERSION 3.25)

# Fail-closed verification of the Phase 14 Mooneye CGB derivative set (D-26; adapted from
# VerifyMooneyeMbc.cmake).
#
#   GBB_MOONEYE_DIR      fixtures/mooneye-cgb (required)
#   GBB_MANIFEST         optional manifest path; defaults to <dir>/manifest.json (tamper controls point elsewhere)
#   GBB_MODE             digest | inventory | pc-table | controls
#   GBB_RUNNER_SOURCE    src/runner/main.c (pc-table only)
#
# Failure tokens: Duplicate fixture id, Duplicate ROM path, Fixture ... mismatch (digest), inventory: ...,
# pc-table-mismatch: ...
# Only portable CMake commands are used (file(SIZE), file(SHA256), string(JSON), cmake_path).

if(NOT DEFINED GBB_MOONEYE_DIR)
  message(FATAL_ERROR "GBB_MOONEYE_DIR is required")
endif()
if(NOT DEFINED GBB_MODE)
  message(FATAL_ERROR "GBB_MODE is required (digest | inventory | pc-table | controls)")
endif()
#
# Controls mode additionally accepts GBB_RUNNER, GBB_TEST_RUNNER, and GBB_CONTROL_DIR.
if(NOT GBB_MODE STREQUAL "digest" AND NOT GBB_MODE STREQUAL "inventory" AND
   NOT GBB_MODE STREQUAL "pc-table" AND NOT GBB_MODE STREQUAL "controls")
  message(FATAL_ERROR "Unknown GBB_MODE: ${GBB_MODE}; expected digest | inventory | pc-table | controls")
endif()

cmake_path(ABSOLUTE_PATH GBB_MOONEYE_DIR
  BASE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/.." NORMALIZE OUTPUT_VARIABLE fixture_dir)
if(DEFINED GBB_MANIFEST AND NOT "${GBB_MANIFEST}" STREQUAL "")
  set(manifest_path "${GBB_MANIFEST}")
else()
  set(manifest_path "${fixture_dir}/manifest.json")
endif()
if(NOT EXISTS "${manifest_path}")
  message(FATAL_ERROR "Missing manifest: ${manifest_path}")
endif()

file(READ "${manifest_path}" manifest_json)
string(JSON fixture_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" fixtures)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT fixture_count EQUAL 9)
  message(FATAL_ERROR "Manifest fixtures must be a JSON array of exactly 9 entries: ${json_error} (${fixture_count})")
endif()

# Read one fixture field, failing with the field name when it is missing or empty.
function(gbb_fixture_field out index field)
  string(JSON value ERROR_VARIABLE json_error GET "${manifest_json}" fixtures ${index} ${field})
  if(NOT json_error STREQUAL "NOTFOUND" OR "${value}" STREQUAL "")
    message(FATAL_ERROR "Fixture ${index} is missing '${field}': ${json_error}")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Per-entry invariants shared by every mode.
set(seen_ids "")
set(seen_roms "")
foreach(index RANGE 0 8)
  gbb_fixture_field(id ${index} id)
  gbb_fixture_field(rom ${index} rom)
  gbb_fixture_field(eligible ${index} eligible)
  if(id IN_LIST seen_ids)
    message(FATAL_ERROR "Duplicate fixture id: ${id}")
  endif()
  if(rom IN_LIST seen_roms)
    message(FATAL_ERROR "Duplicate ROM path in eligible inventory: ${rom}")
  endif()
  if(rom MATCHES "[/\\\\]|\\.\\.")
    message(FATAL_ERROR "Fixture ROM must be a local filename: ${rom}")
  endif()
  if(NOT eligible)
    message(FATAL_ERROR "Every entry in fixtures must be eligible: ${id}")
  endif()
  list(APPEND seen_ids "${id}")
  list(APPEND seen_roms "${rom}")
endforeach()

if(GBB_MODE STREQUAL "inventory")
  # The exact nine-ROM set, in manifest order, with author assertion and observed disposition separate.
  set(want_ids boot_regs-cgb boot_div-cgbABCDE boot_hwio-C unused_hwio-C daa div_write tim00 tim00_div_trigger vblank_stat_intr-C)
  set(want_categories post-boot-registers post-boot-div post-boot-hwio unused-hwio instruction timer timer timer ppu)
  set(want_expects pass pass pass pass pass pass pass pass pass)
  set(want_dispositions pass pass expected-failure expected-failure pass pass pass pass expected-failure)
  string(JSON required_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" required_roms)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT required_count EQUAL 9)
    message(FATAL_ERROR "inventory: required_roms must list exactly 9 ROMs (${required_count})")
  endif()
  foreach(index RANGE 0 8)
    list(GET want_ids ${index} want_id)
    gbb_fixture_field(alias ${index} alias)
    gbb_fixture_field(category ${index} category)
    gbb_fixture_field(expect ${index} expect)
    gbb_fixture_field(disposition ${index} observed_disposition)
    gbb_fixture_field(rom ${index} rom)
    gbb_fixture_field(model_mode ${index} mode)
    gbb_fixture_field(header_143 ${index} cart_header_143)
    string(JSON model_count ERROR_VARIABLE model_error LENGTH "${manifest_json}" fixtures ${index} model_pass)
    if(NOT model_error STREQUAL "NOTFOUND" OR NOT model_count EQUAL 1)
      message(FATAL_ERROR "inventory: ${alias} must target exactly one model (${model_count})")
    endif()
    string(JSON model_pass GET "${manifest_json}" fixtures ${index} model_pass 0)
    list(GET want_categories ${index} want_category)
    list(GET want_expects ${index} want_expect)
    list(GET want_dispositions ${index} want_disposition)
    if(NOT alias STREQUAL want_id)
      message(FATAL_ERROR "inventory: fixture ${index} alias '${alias}' must be '${want_id}'")
    endif()
    if(NOT category STREQUAL want_category)
      message(FATAL_ERROR "inventory: ${alias} category '${category}' must be '${want_category}'")
    endif()
    if(NOT expect STREQUAL want_expect)
      message(FATAL_ERROR "inventory: ${alias} expect '${expect}' must be '${want_expect}'")
    endif()
    if(NOT disposition STREQUAL want_disposition)
      message(FATAL_ERROR "inventory: ${alias} observed_disposition '${disposition}' must be '${want_disposition}'")
    endif()
    if(NOT model_pass STREQUAL "cgb-cpu-e" OR
       NOT model_mode STREQUAL "compat (header $143 bit 7 clear)" OR
       NOT header_143 STREQUAL "0x00")
      message(FATAL_ERROR "inventory: ${alias} model/mode/header metadata mismatch")
    endif()
    string(JSON required_rom ERROR_VARIABLE json_error GET "${manifest_json}" required_roms ${index})
    if(NOT json_error STREQUAL "NOTFOUND" OR NOT required_rom STREQUAL rom)
      message(FATAL_ERROR "inventory: required_roms[${index}] '${required_rom}' must equal fixture ROM '${rom}'")
    endif()
  endforeach()
  message(STATUS "Verified Mooneye-cgb inventory: 9 fixtures (6 observed pass, 3 exact expected-failure dispositions; all author expectations remain pass), 9 required ROM(s)")
  return()
endif()

if(GBB_MODE STREQUAL "controls")
  foreach(required_var IN ITEMS GBB_RUNNER GBB_TEST_RUNNER GBB_CONTROL_DIR)
    if(NOT DEFINED ${required_var} OR "${${required_var}}" STREQUAL "")
      message(FATAL_ERROR "controls mode needs ${required_var}")
    endif()
  endforeach()
  file(MAKE_DIRECTORY "${GBB_CONTROL_DIR}/missing" "${GBB_CONTROL_DIR}/model"
    "${GBB_CONTROL_DIR}/mode" "${GBB_CONTROL_DIR}/expect")

  file(WRITE "${GBB_CONTROL_DIR}/missing/manifest.json" "${manifest_json}")
  execute_process(COMMAND "${GBB_RUNNER}" --manifest "${GBB_CONTROL_DIR}/missing/manifest.json"
    --case vblank_stat_intr-C --profile cgb --receipt
    RESULT_VARIABLE missing_code OUTPUT_VARIABLE missing_out ERROR_VARIABLE missing_err)
  string(CONCAT missing_output "${missing_out}" "${missing_err}")
  if(NOT missing_code EQUAL 3 OR NOT missing_output MATCHES "reason=missing-fixture")
    message(FATAL_ERROR "control=missing-required-rom expected exit 3 and missing-fixture, got ${missing_code}: ${missing_output}")
  endif()
  message(STATUS "control=missing-required-rom rejected: missing-fixture")

  string(JSON wrong_model SET "${manifest_json}" fixtures 8 model_pass "[\"cgb-cpu-d\"]")
  file(WRITE "${GBB_CONTROL_DIR}/model/manifest.json" "${wrong_model}")
  execute_process(COMMAND "${GBB_RUNNER}" --manifest "${GBB_CONTROL_DIR}/model/manifest.json"
    --case vblank_stat_intr-C --profile cgb --receipt
    RESULT_VARIABLE model_code OUTPUT_VARIABLE model_out ERROR_VARIABLE model_err)
  string(CONCAT model_output "${model_out}" "${model_err}")
  if(NOT model_code EQUAL 2 OR NOT model_output MATCHES "invalid-manifest")
    message(FATAL_ERROR "control=wrong-model expected invalid-manifest, got ${model_code}: ${model_output}")
  endif()
  message(STATUS "control=wrong-model rejected: invalid-manifest")

  string(JSON wrong_mode SET "${manifest_json}" fixtures 8 mode "\"native\"")
  file(WRITE "${GBB_CONTROL_DIR}/mode/manifest.json" "${wrong_mode}")
  execute_process(COMMAND "${GBB_RUNNER}" --manifest "${GBB_CONTROL_DIR}/mode/manifest.json"
    --case vblank_stat_intr-C --profile cgb --receipt
    RESULT_VARIABLE mode_code OUTPUT_VARIABLE mode_out ERROR_VARIABLE mode_err)
  string(CONCAT mode_output "${mode_out}" "${mode_err}")
  if(NOT mode_code EQUAL 2 OR NOT mode_output MATCHES "invalid-manifest")
    message(FATAL_ERROR "control=wrong-mode expected invalid-manifest, got ${mode_code}: ${mode_output}")
  endif()
  message(STATUS "control=wrong-mode rejected: invalid-manifest")

  string(JSON tampered_disposition SET "${manifest_json}" fixtures 2 observed_disposition "\"pass\"")
  file(WRITE "${GBB_CONTROL_DIR}/expect/manifest.json" "${tampered_disposition}")
  execute_process(COMMAND "${GBB_TEST_RUNNER}" cgb_mooneye_expected_disposition_controls
    "${GBB_CONTROL_DIR}/expect/manifest.json" "${manifest_path}" "${fixture_dir}"
    RESULT_VARIABLE signature_code OUTPUT_VARIABLE signature_out ERROR_VARIABLE signature_err)
  string(CONCAT signature_output "${signature_out}" "${signature_err}")
  if(NOT signature_code EQUAL 0 OR
     NOT signature_output MATCHES "control=expected-failure-wrong-callback alias=vblank_stat_intr-C" OR
     NOT signature_output MATCHES "control=expected-failure-changed-registers alias=vblank_stat_intr-C" OR
     NOT signature_output MATCHES "control=xfail-tampered-to-pass")
    message(FATAL_ERROR "control=changed-expected-signature failed (${signature_code}): ${signature_output}")
  endif()
  message(STATUS "control=changed-expected-signature rejected: wrong-callback and wrong-register signatures")
  return()
endif()

if(GBB_MODE STREQUAL "pc-table")
  if(NOT DEFINED GBB_RUNNER_SOURCE OR NOT EXISTS "${GBB_RUNNER_SOURCE}")
    message(FATAL_ERROR "pc-table mode needs an existing GBB_RUNNER_SOURCE")
  endif()
  file(READ "${GBB_RUNNER_SOURCE}" runner_source)
  string(FIND "${runner_source}" "gbb:cgb-rows-begin" rows_begin)
  string(FIND "${runner_source}" "gbb:cgb-rows-end" rows_end)
  if(rows_begin LESS 0 OR rows_end LESS rows_begin)
    message(FATAL_ERROR "pc-table-mismatch: runner source has no cgb row markers")
  endif()
  math(EXPR rows_length "${rows_end} - ${rows_begin}")
  string(SUBSTRING "${runner_source}" ${rows_begin} ${rows_length} rows_region)
  # Rows contain no semicolons or brackets, so a newline-to-semicolon swap yields a clean list.
  string(REPLACE "\n" ";" row_lines "${rows_region}")
  set(rows "")
  foreach(line IN LISTS row_lines)
    string(STRIP "${line}" line)
    if(line MATCHES "^\\{\"")
      list(APPEND rows "${line}")
    endif()
  endforeach()
  list(LENGTH rows row_count)
  if(NOT row_count EQUAL 9)
    message(FATAL_ERROR "pc-table-mismatch: runner source has ${row_count} cgb rows, expected 9")
  endif()

  foreach(index RANGE 0 8)
    gbb_fixture_field(id ${index} id)
    gbb_fixture_field(alias ${index} alias)
    gbb_fixture_field(category ${index} category)
    gbb_fixture_field(rom ${index} rom)
    gbb_fixture_field(sha256 ${index} sha256)
    gbb_fixture_field(original_sha256 ${index} original_sha256)
    gbb_fixture_field(size_bytes ${index} size_bytes)
    gbb_fixture_field(source_path ${index} source_path)
    gbb_fixture_field(result_pc ${index} result_pc)
    gbb_fixture_field(pass_pc ${index} pass_callback_pc)
    gbb_fixture_field(budget ${index} budget_half_dots)
    gbb_fixture_field(expect ${index} expect)
    gbb_fixture_field(disposition ${index} observed_disposition)
    string(JSON fail_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" fixtures ${index} fail_callback_pcs)
    if(NOT json_error STREQUAL "NOTFOUND" OR fail_count LESS 1 OR fail_count GREATER 6)
      message(FATAL_ERROR "pc-table-mismatch: ${id} needs 1 to 6 fail_callback_pcs (${fail_count})")
    endif()
    set(fail_list "")
    foreach(fail_index RANGE 0 5)
      if(fail_index EQUAL fail_count)
        break()
      endif()
      string(JSON fail_pc GET "${manifest_json}" fixtures ${index} fail_callback_pcs ${fail_index})
      list(APPEND fail_list "${fail_pc}")
    endforeach()
    list(JOIN fail_list ", " fail_joined)
    list(GET fail_list 0 first_fail)
    # observed pass -> compiled disposition 0; expected-unsupported -> 1; exact protocol xfail -> 2.
    if(disposition STREQUAL "expected-unsupported")
      gbb_fixture_field(stop_address ${index} expect_stop_address)
      set(want_disposition GBB_OBSERVED_UNSUPPORTED)
    elseif(disposition STREQUAL "expected-failure")
      set(stop_address "0x0000")
      set(want_disposition GBB_OBSERVED_FAILURE)
    else()
      set(stop_address "0x0000")
      set(want_disposition GBB_OBSERVED_PASS)
    endif()

    set(match_row "")
    set(match_count 0)
    foreach(row IN LISTS rows)
      string(FIND "${row}" "{\"${id}\"," at)
      if(at EQUAL 0)
        set(match_row "${row}")
        math(EXPR match_count "${match_count} + 1")
      endif()
    endforeach()
    if(NOT match_count EQUAL 1)
      message(FATAL_ERROR "pc-table-mismatch: ${id} row (${match_count} rows found)")
    endif()

    # Each field is pinned with its neighbours so a value cannot match inside another column.
    set(checks
      "alias|{\"${id}\", \"${alias}\", \"${category}\", \"${rom}\", \"${sha256}\", \"${original_sha256}\","
      "pass_callback_pc|\"${source_path}\", ${pass_pc}, ${first_fail}, 0x"
      "result_pc|, ${result_pc}, {3, 5, 8, 13, 21, 34}, {0x42, 0x42, 0x42, 0x42, 0x42, 0x42}"
      "budget|{0x42, 0x42, 0x42, 0x42, 0x42, 0x42}, UINT64_C(${budget}), "
      "size_bytes|, ${size_bytes}u, {"
      "fail_callback_pcs|{${fail_joined}}, ${fail_count}, "
      "profile_and_disposition|, GBB_PROFILE_CGB_CPU_E, ${want_disposition}, ${stop_address}}")
    foreach(check IN LISTS checks)
      string(FIND "${check}" "|" bar)
      string(SUBSTRING "${check}" 0 ${bar} field)
      math(EXPR needle_start "${bar} + 1")
      string(SUBSTRING "${check}" ${needle_start} -1 needle)
      string(FIND "${match_row}" "${needle}" found)
      if(found LESS 0)
        message(FATAL_ERROR "pc-table-mismatch: ${id} ${field}")
      endif()
    endforeach()
  endforeach()

  # The raw-manifest gate constant must be the digest of the manifest these rows were checked against;
  # tested last so a changed row is named before the digest mismatch hides it.
  file(SHA256 "${manifest_path}" manifest_digest)
  string(FIND "${runner_source}" "#define MOONEYE_CGB_MANIFEST_SHA256 \"${manifest_digest}\"" digest_found)
  if(digest_found LESS 0)
    message(FATAL_ERROR "pc-table-mismatch: MOONEYE_CGB_MANIFEST_SHA256 is not the digest ${manifest_digest}")
  endif()
  message(STATUS "Verified pc-table: 9 manifest rows agree with the compiled cgb_cases[]")
  return()
endif()

# ---- digest mode ----
foreach(required_file IN ITEMS manifest.json LICENSE.txt FONT-LICENSE.txt SOURCES.md ELIGIBILITY.md)
  if(NOT EXISTS "${fixture_dir}/${required_file}")
    message(FATAL_ERROR "Missing required Mooneye-cgb corpus file: ${required_file}")
  endif()
endforeach()

foreach(index RANGE 0 8)
  gbb_fixture_field(id ${index} id)
  gbb_fixture_field(rom ${index} rom)
  gbb_fixture_field(digest ${index} sha256)
  gbb_fixture_field(expected_size ${index} size_bytes)
  string(LENGTH "${digest}" digest_length)
  if(NOT digest MATCHES "^[0-9a-fA-F]+$" OR NOT digest_length EQUAL 64 OR
     NOT expected_size MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Fixture ${id} has malformed size or SHA-256 metadata")
  endif()
  set(rom_path "${fixture_dir}/${rom}")
  if(NOT EXISTS "${rom_path}")
    message(FATAL_ERROR "Missing required selected ROM: ${rom_path}")
  endif()
  file(SIZE "${rom_path}" actual_size)
  file(SHA256 "${rom_path}" actual_digest)
  if(NOT actual_size EQUAL expected_size OR NOT actual_digest STREQUAL digest)
    message(FATAL_ERROR "Fixture ${id} mismatch: size ${actual_size}/${expected_size}, SHA-256 ${actual_digest}/${digest}")
  endif()
endforeach()

# Parent references (D-24): three real repository files, each with its own matching SHA-256.
cmake_path(ABSOLUTE_PATH fixture_dir BASE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/.." NORMALIZE OUTPUT_VARIABLE fixture_dir_norm)
cmake_path(GET fixture_dir_norm PARENT_PATH fixtures_root)
cmake_path(GET fixtures_root PARENT_PATH repo_root)
string(JSON ref_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" parent_references)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT ref_count EQUAL 3)
  message(FATAL_ERROR "parent_references must list exactly three entries (${ref_count})")
endif()
set(expected_refs ../mooneye/headless-report.patch ../mooneye/font-source.c ../mooneye/manifest.json)
set(ref_paths "")
foreach(index RANGE 0 2)
  string(JSON ref_path ERROR_VARIABLE json_error GET "${manifest_json}" parent_references ${index} path)
  string(JSON ref_sha ERROR_VARIABLE json_error2 GET "${manifest_json}" parent_references ${index} sha256)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT json_error2 STREQUAL "NOTFOUND" OR ref_path STREQUAL "")
    message(FATAL_ERROR "parent-reference-invalid: entry ${index} lacks path or sha256")
  endif()
  if(ref_path MATCHES "#" OR ref_path MATCHES "\\\\" OR IS_ABSOLUTE "${ref_path}")
    message(FATAL_ERROR "parent-reference-invalid: ${ref_path}")
  endif()
  cmake_path(APPEND fixture_dir_norm "${ref_path}" OUTPUT_VARIABLE ref_abs)
  cmake_path(NORMAL_PATH ref_abs)
  string(FIND "${ref_abs}" "${repo_root}/" inside_repo)
  if(NOT inside_repo EQUAL 0)
    message(FATAL_ERROR "parent-reference-invalid: ${ref_path}")
  endif()
  if(NOT EXISTS "${ref_abs}" OR IS_DIRECTORY "${ref_abs}")
    message(FATAL_ERROR "parent-reference-invalid: ${ref_path}")
  endif()
  file(SHA256 "${ref_abs}" ref_actual)
  if(NOT ref_actual STREQUAL ref_sha)
    message(FATAL_ERROR "parent-reference-digest: ${ref_path}")
  endif()
  list(APPEND ref_paths "${ref_path}")
  if(ref_path STREQUAL "../mooneye/manifest.json")
    set(parent_manifest_path "${ref_abs}")
  endif()
endforeach()
if(NOT ref_paths STREQUAL expected_refs)
  message(FATAL_ERROR "parent-reference-invalid: expected exactly ${expected_refs}, got ${ref_paths}")
endif()

# The builder pin lives in the digest-checked parent manifest and is referenced, not copied (D-24).
string(JSON own_builder_type ERROR_VARIABLE json_error TYPE "${manifest_json}" builder)
if(json_error STREQUAL "NOTFOUND")
  message(FATAL_ERROR "builder-pin-mismatch: the sibling manifest must not carry its own builder object")
endif()
file(READ "${parent_manifest_path}" parent_json)
string(JSON builder_revision ERROR_VARIABLE json_error GET "${parent_json}" builder source_revision)
string(JSON builder_archive ERROR_VARIABLE json_error2 GET "${parent_json}" builder git_archive_sha256)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT json_error2 STREQUAL "NOTFOUND" OR
   NOT builder_revision STREQUAL "91c52b1f4ef3cc8ba3c0638f7536539579af6a9f" OR builder_archive STREQUAL "")
  message(FATAL_ERROR "builder-pin-mismatch: parent manifest must pin WLA-DX 91c52b1f4ef3cc8ba3c0638f7536539579af6a9f")
endif()

string(JSON suite_revision GET "${manifest_json}" suite revision)
string(JSON suite_tree GET "${manifest_json}" suite tree_sha1)
if(NOT suite_revision STREQUAL "31510e12eea6286d36eea060a6adde755e1067aa" OR
   NOT suite_tree STREQUAL "2b8c52424a49a2a7466cf631fd8992c53d0de2fa")
  message(FATAL_ERROR "Mooneye source revision or tree does not match the reviewed immutable pin")
endif()

message(STATUS "Verified 9 eligible Mooneye-cgb ROM(s) against ${manifest_path}")
