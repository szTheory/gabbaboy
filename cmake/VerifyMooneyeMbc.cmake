cmake_minimum_required(VERSION 3.25)

# Fail-closed verification of the Phase 8 Mooneye mbc2/mbc5 derivative set (adapted from VerifyMooneye.cmake).
#
#   GBB_MOONEYE_DIR      fixtures/mooneye-mbc (required)
#   GBB_MANIFEST         optional manifest path; defaults to <dir>/manifest.json (the tamper control points elsewhere)
#   GBB_MODE             digest | inventory | pc-table
#   GBB_RUNNER_SOURCE    src/runner/main.c (pc-table only)
#
# Only portable CMake commands are used (file(SIZE), file(SHA256), string(JSON), cmake_path, string(REGEX)).

if(NOT DEFINED GBB_MOONEYE_DIR)
  message(FATAL_ERROR "GBB_MOONEYE_DIR is required")
endif()
if(NOT DEFINED GBB_MODE)
  message(FATAL_ERROR "GBB_MODE is required (digest | inventory | pc-table)")
endif()
if(NOT GBB_MODE STREQUAL "digest" AND NOT GBB_MODE STREQUAL "inventory" AND NOT GBB_MODE STREQUAL "pc-table")
  message(FATAL_ERROR "Unknown GBB_MODE: ${GBB_MODE}")
endif()

cmake_path(ABSOLUTE_PATH GBB_MOONEYE_DIR
  BASE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/.." NORMALIZE OUTPUT_VARIABLE fixture_dir)
if(DEFINED GBB_MANIFEST AND NOT "${GBB_MANIFEST}" STREQUAL "")
  set(manifest_path "${GBB_MANIFEST}")
else()
  set(manifest_path "${fixture_dir}/manifest.json")
endif()
if(NOT EXISTS "${manifest_path}")
  message(FATAL_ERROR "Missing manifest: ${manifest_path}")
endif()

file(READ "${manifest_path}" manifest_json)
string(JSON fixture_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" fixtures)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT fixture_count EQUAL 15)
  message(FATAL_ERROR "Manifest fixtures must be a JSON array of exactly 15 entries: ${json_error} (${fixture_count})")
endif()

# Read one fixture field, failing with the field name when it is missing or empty.
function(gbb_fixture_field out index field)
  string(JSON value ERROR_VARIABLE json_error GET "${manifest_json}" fixtures ${index} ${field})
  if(NOT json_error STREQUAL "NOTFOUND" OR "${value}" STREQUAL "")
    message(FATAL_ERROR "Fixture ${index} is missing '${field}': ${json_error}")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Collect the eligible ROM names and enforce the per-entry invariants shared by every mode.
set(seen_ids "")
set(seen_roms "")
set(mbc2_count 0)
set(mbc5_count 0)
foreach(index RANGE 0 14)
  gbb_fixture_field(id ${index} id)
  gbb_fixture_field(rom ${index} rom)
  gbb_fixture_field(category ${index} category)
  gbb_fixture_field(eligible ${index} eligible)
  if(id IN_LIST seen_ids)
    message(FATAL_ERROR "Duplicate fixture id: ${id}")
  endif()
  if(rom IN_LIST seen_roms)
    message(FATAL_ERROR "Duplicate ROM path in eligible inventory: ${rom}")
  endif()
  if(rom MATCHES "[/\\\\]|\\.\\.")
    message(FATAL_ERROR "Fixture ROM must be a local filename: ${rom}")
  endif()
  if(NOT eligible)
    message(FATAL_ERROR "Every entry in fixtures must be eligible: ${id}")
  endif()
  if(category STREQUAL "mbc2")
    math(EXPR mbc2_count "${mbc2_count} + 1")
  elseif(category STREQUAL "mbc5")
    math(EXPR mbc5_count "${mbc5_count} + 1")
  else()
    message(FATAL_ERROR "Unsupported eligible category '${category}' for ${id}")
  endif()
  list(APPEND seen_ids "${id}")
  list(APPEND seen_roms "${rom}")
endforeach()

if(GBB_MODE STREQUAL "inventory")
  string(JSON cat_mbc2 ERROR_VARIABLE json_error GET "${manifest_json}" categories mbc2)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT cat_mbc2 EQUAL 7 OR NOT mbc2_count EQUAL 7)
    message(FATAL_ERROR "inventory: categories.mbc2 must be exactly 7 (declared '${cat_mbc2}', counted ${mbc2_count})")
  endif()
  string(JSON cat_mbc5 ERROR_VARIABLE json_error GET "${manifest_json}" categories mbc5)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT cat_mbc5 EQUAL 8 OR NOT mbc5_count EQUAL 8)
    message(FATAL_ERROR "inventory: categories.mbc5 must be exactly 8 (declared '${cat_mbc5}', counted ${mbc5_count})")
  endif()
  string(JSON categories_count LENGTH "${manifest_json}" categories)
  if(NOT categories_count EQUAL 2)
    message(FATAL_ERROR "inventory: categories must contain exactly mbc2 and mbc5")
  endif()

  string(JSON required_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" required_roms)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT required_count EQUAL 15)
    message(FATAL_ERROR "inventory: required_roms must list exactly 15 ROMs (${required_count})")
  endif()
  set(required_roms "")
  foreach(index RANGE 0 14)
    string(JSON required_rom ERROR_VARIABLE json_error GET "${manifest_json}" required_roms ${index})
    if(NOT json_error STREQUAL "NOTFOUND" OR required_rom MATCHES "[/\\\\]|\\.\\.")
      message(FATAL_ERROR "inventory: invalid required ROM at index ${index}: ${required_rom}")
    endif()
    if(required_rom IN_LIST required_roms)
      message(FATAL_ERROR "inventory: duplicate required ROM: ${required_rom}")
    endif()
    list(APPEND required_roms "${required_rom}")
  endforeach()
  foreach(rom IN LISTS required_roms)
    if(NOT rom IN_LIST seen_roms)
      message(FATAL_ERROR "inventory: required ROM is not represented in the eligible manifest: ${rom}")
    endif()
  endforeach()
  foreach(rom IN LISTS seen_roms)
    if(NOT rom IN_LIST required_roms)
      message(FATAL_ERROR "inventory: eligible ROM is missing from required_roms: ${rom}")
    endif()
  endforeach()

  foreach(index RANGE 0 14)
    gbb_fixture_field(id ${index} id)
    foreach(field IN ITEMS result_pc pass_callback_pc budget_half_dots)
      gbb_fixture_field(value ${index} ${field})
    endforeach()
    gbb_fixture_field(budget ${index} budget_half_dots)
    if(NOT budget MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "inventory: ${id} has no finite positive budget_half_dots")
    endif()
    string(JSON fail_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" fixtures ${index} fail_callback_pcs)
    if(NOT json_error STREQUAL "NOTFOUND" OR fail_count LESS 1 OR fail_count GREATER 6)
      message(FATAL_ERROR "inventory: ${id} needs 1 to 6 fail_callback_pcs (${fail_count})")
    endif()
  endforeach()
  message(STATUS "Verified Mooneye-mbc inventory: ${mbc2_count} mbc2, ${mbc5_count} mbc5, 15 required ROM(s)")
  return()
endif()

if(GBB_MODE STREQUAL "pc-table")
  if(NOT DEFINED GBB_RUNNER_SOURCE OR NOT EXISTS "${GBB_RUNNER_SOURCE}")
    message(FATAL_ERROR "pc-table mode needs an existing GBB_RUNNER_SOURCE")
  endif()
  file(READ "${GBB_RUNNER_SOURCE}" runner_source)
  string(FIND "${runner_source}" "gbb:mbc-rows-begin" rows_begin)
  string(FIND "${runner_source}" "gbb:mbc-rows-end" rows_end)
  if(rows_begin LESS 0 OR rows_end LESS rows_begin)
    message(FATAL_ERROR "pc-table-mismatch: runner source has no mbc row markers")
  endif()
  math(EXPR rows_length "${rows_end} - ${rows_begin}")
  string(SUBSTRING "${runner_source}" ${rows_begin} ${rows_length} rows_region)
  # Rows contain no semicolons or brackets, so a newline-to-semicolon swap yields a clean list.
  string(REPLACE "\n" ";" row_lines "${rows_region}")
  set(rows "")
  foreach(line IN LISTS row_lines)
    string(STRIP "${line}" line)
    if(line MATCHES "^\\{\"")
      list(APPEND rows "${line}")
    endif()
  endforeach()
  list(LENGTH rows row_count)
  if(NOT row_count EQUAL 15)
    message(FATAL_ERROR "pc-table-mismatch: runner source has ${row_count} mbc rows, expected 15")
  endif()

  foreach(index RANGE 0 14)
    gbb_fixture_field(id ${index} id)
    gbb_fixture_field(alias ${index} alias)
    gbb_fixture_field(category ${index} category)
    gbb_fixture_field(rom ${index} rom)
    gbb_fixture_field(sha256 ${index} sha256)
    gbb_fixture_field(size_bytes ${index} size_bytes)
    gbb_fixture_field(source_path ${index} source_path)
    gbb_fixture_field(result_pc ${index} result_pc)
    gbb_fixture_field(pass_pc ${index} pass_callback_pc)
    gbb_fixture_field(budget ${index} budget_half_dots)
    string(JSON fail_count LENGTH "${manifest_json}" fixtures ${index} fail_callback_pcs)
    set(fail_list "")
    foreach(fail_index RANGE 0 5)
      if(fail_index EQUAL fail_count)
        break()
      endif()
      string(JSON fail_pc GET "${manifest_json}" fixtures ${index} fail_callback_pcs ${fail_index})
      list(APPEND fail_list "${fail_pc}")
    endforeach()
    list(JOIN fail_list ", " fail_joined)
    list(GET fail_list 0 first_fail)

    set(match_row "")
    set(match_count 0)
    foreach(row IN LISTS rows)
      string(FIND "${row}" "{\"${id}\"," at)
      if(at EQUAL 0)
        set(match_row "${row}")
        math(EXPR match_count "${match_count} + 1")
      endif()
    endforeach()
    if(NOT match_count EQUAL 1)
      message(FATAL_ERROR "pc-table-mismatch: ${id} row (${match_count} rows found)")
    endif()

    # Each field is pinned with its neighbours so a value cannot match inside another column.
    set(checks
      "alias|{\"${id}\", \"${alias}\", \"${category}\", \"${rom}\", \"${sha256}\","
      "pass_callback_pc|\"${source_path}\", ${pass_pc}, ${first_fail}, 0x"
      "result_pc|, ${result_pc}, {3, 5, 8, 13, 21, 34}, {0x42, 0x42, 0x42, 0x42, 0x42, 0x42}"
      "budget|{0x42, 0x42, 0x42, 0x42, 0x42, 0x42}, UINT64_C(${budget}), "
      "size_bytes|, ${size_bytes}u, {"
      "fail_callback_pcs|{${fail_joined}}, ${fail_count}}")
    foreach(check IN LISTS checks)
      string(FIND "${check}" "|" bar)
      string(SUBSTRING "${check}" 0 ${bar} field)
      math(EXPR needle_start "${bar} + 1")
      string(SUBSTRING "${check}" ${needle_start} -1 needle)
      string(FIND "${match_row}" "${needle}" found)
      if(found LESS 0)
        message(FATAL_ERROR "pc-table-mismatch: ${id} ${field}")
      endif()
    endforeach()
  endforeach()
  message(STATUS "Verified pc-table: 15 manifest rows agree with the compiled mbc_cases[]")
  return()
endif()

# ---- digest mode ----
foreach(required_file IN ITEMS manifest.json LICENSE.txt FONT-LICENSE.txt SOURCES.md ELIGIBILITY.md)
  if(NOT EXISTS "${fixture_dir}/${required_file}")
    message(FATAL_ERROR "Missing required Mooneye-mbc corpus file: ${required_file}")
  endif()
endforeach()

foreach(index RANGE 0 14)
  gbb_fixture_field(id ${index} id)
  gbb_fixture_field(rom ${index} rom)
  gbb_fixture_field(digest ${index} sha256)
  gbb_fixture_field(expected_size ${index} size_bytes)
  string(LENGTH "${digest}" digest_length)
  if(NOT digest MATCHES "^[0-9a-fA-F]+$" OR NOT digest_length EQUAL 64 OR
     NOT expected_size MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Fixture ${id} has malformed size or SHA-256 metadata")
  endif()
  set(rom_path "${fixture_dir}/${rom}")
  if(NOT EXISTS "${rom_path}")
    message(FATAL_ERROR "Missing required selected ROM: ${rom_path}")
  endif()
  file(SIZE "${rom_path}" actual_size)
  file(SHA256 "${rom_path}" actual_digest)
  if(NOT actual_size EQUAL expected_size OR NOT actual_digest STREQUAL digest)
    message(FATAL_ERROR "Fixture ${id} mismatch: size ${actual_size}/${expected_size}, SHA-256 ${actual_digest}/${digest}")
  endif()
endforeach()

# Parent references (D-24): three real repository files, each with its own matching SHA-256.
cmake_path(ABSOLUTE_PATH fixture_dir BASE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/.." NORMALIZE OUTPUT_VARIABLE fixture_dir_norm)
cmake_path(GET fixture_dir_norm PARENT_PATH fixtures_root)
cmake_path(GET fixtures_root PARENT_PATH repo_root)
string(JSON ref_count ERROR_VARIABLE json_error LENGTH "${manifest_json}" parent_references)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT ref_count EQUAL 3)
  message(FATAL_ERROR "parent_references must list exactly three entries (${ref_count})")
endif()
set(expected_refs ../mooneye/headless-report.patch ../mooneye/font-source.c ../mooneye/manifest.json)
set(ref_paths "")
foreach(index RANGE 0 2)
  string(JSON ref_path ERROR_VARIABLE json_error GET "${manifest_json}" parent_references ${index} path)
  string(JSON ref_sha ERROR_VARIABLE json_error2 GET "${manifest_json}" parent_references ${index} sha256)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT json_error2 STREQUAL "NOTFOUND" OR ref_path STREQUAL "")
    message(FATAL_ERROR "parent-reference-invalid: entry ${index} lacks path or sha256")
  endif()
  if(ref_path MATCHES "#" OR ref_path MATCHES "\\\\" OR IS_ABSOLUTE "${ref_path}")
    message(FATAL_ERROR "parent-reference-invalid: ${ref_path}")
  endif()
  cmake_path(APPEND fixture_dir_norm "${ref_path}" OUTPUT_VARIABLE ref_abs)
  cmake_path(NORMAL_PATH ref_abs)
  string(FIND "${ref_abs}" "${repo_root}/" inside_repo)
  if(NOT inside_repo EQUAL 0)
    message(FATAL_ERROR "parent-reference-invalid: ${ref_path}")
  endif()
  if(NOT EXISTS "${ref_abs}" OR IS_DIRECTORY "${ref_abs}")
    message(FATAL_ERROR "parent-reference-invalid: ${ref_path}")
  endif()
  file(SHA256 "${ref_abs}" ref_actual)
  if(NOT ref_actual STREQUAL ref_sha)
    message(FATAL_ERROR "parent-reference-digest: ${ref_path}")
  endif()
  list(APPEND ref_paths "${ref_path}")
  if(ref_path STREQUAL "../mooneye/manifest.json")
    set(parent_manifest_path "${ref_abs}")
  endif()
endforeach()
if(NOT ref_paths STREQUAL expected_refs)
  message(FATAL_ERROR "parent-reference-invalid: expected exactly ${expected_refs}, got ${ref_paths}")
endif()

# The builder pin lives in the digest-checked parent manifest and is referenced, not copied (D-24).
string(JSON own_builder_type ERROR_VARIABLE json_error TYPE "${manifest_json}" builder)
if(json_error STREQUAL "NOTFOUND")
  message(FATAL_ERROR "builder-pin-mismatch: the sibling manifest must not carry its own builder object")
endif()
file(READ "${parent_manifest_path}" parent_json)
string(JSON builder_revision ERROR_VARIABLE json_error GET "${parent_json}" builder source_revision)
string(JSON builder_archive ERROR_VARIABLE json_error2 GET "${parent_json}" builder git_archive_sha256)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT json_error2 STREQUAL "NOTFOUND" OR
   NOT builder_revision STREQUAL "91c52b1f4ef3cc8ba3c0638f7536539579af6a9f" OR builder_archive STREQUAL "")
  message(FATAL_ERROR "builder-pin-mismatch: parent manifest must pin WLA-DX 91c52b1f4ef3cc8ba3c0638f7536539579af6a9f")
endif()

string(JSON suite_revision GET "${manifest_json}" suite revision)
string(JSON suite_tree GET "${manifest_json}" suite tree_sha1)
if(NOT suite_revision STREQUAL "31510e12eea6286d36eea060a6adde755e1067aa" OR
   NOT suite_tree STREQUAL "2b8c52424a49a2a7466cf631fd8992c53d0de2fa")
  message(FATAL_ERROR "Mooneye source revision or tree does not match the reviewed immutable pin")
endif()

message(STATUS "Verified 15 eligible Mooneye-mbc ROM(s): ${mbc2_count} mbc2, ${mbc5_count} mbc5")
